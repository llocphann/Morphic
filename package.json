{
    "name": "morphic",
    "version": "0.1.2",
    "private": true,
    "description": "Performance-first programmable views for Obsidian notes, with rules, templates, Bases integration, and live editing.",
    "main": "main.js",
    "packageManager": "npm@11.6.0",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check:repo-hygiene": "node scripts/repository-hygiene.mjs",
        "check:release-metadata": "node scripts/check-release-metadata.mjs",
        "bench:compiler": "vitest bench src/__benchmarks__/compiler.bench.ts --run",
        "bench:core": "vitest bench src/__benchmarks__/core-v2-certification.bench.ts --run",
        "bench:release": "vitest bench src/__benchmarks__ --run",
        "bench:competitive": "node scripts/competitive-benchmark.mjs",
        "audit:provenance": "node scripts/provenance-audit.mjs"
    },
    "keywords": [
        "obsidian",
        "views",
        "templates",
        "performance"
    ],
    "author": "Lộc Phan",
    "license": "GPL-3.0-only",
    "funding": "https://www.buymeacoffee.com/llocphann",
    "engines": {
        "node": "22.x",
        "npm": "11.6.0"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.0.0",
        "@codemirror/commands": "^6.0.0",
        "@codemirror/language": "^6.0.0",
        "@codemirror/lint": "^6.0.0",
        "@codemirror/search": "^6.0.0",
        "@codemirror/state": "6.5.0",
        "@codemirror/view": "6.38.6",
        "@eslint/compat": "^2.0.0",
        "@eslint/json": "^0.14.0",
        "@lezer/common": "^1.0.3",
        "@lezer/css": "^1.3.3",
        "@lezer/highlight": "^1.2.3",
        "@lezer/html": "^1.3.13",
        "@lezer/javascript": "^1.5.4",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "@typescript-eslint/utils": "^8.51.0",
        "@vitest/coverage-v8": "^4.1.6",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.3.0",
        "jsdom": "^29.1.1",
        "moment": "^2.30.1",
        "obsidian": "1.13.1",
        "tslib": "2.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.51.0",
        "vitest": "^4.1.6"
    }
}
